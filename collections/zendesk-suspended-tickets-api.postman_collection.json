          "id": "5d8e304c-c7d4-4d71-b1f6-3ac487058ea3",
          "name": "Zendesk Post  Api V2 Suspended_tickets Attachments",
          "request": {
            "name": "Zendesk Post  Api V2 Suspended_tickets Attachments",
            "description": {
              "content": "Makes copies of any attachments on a suspended ticket and returns them as [attachment tokens](/api-reference/ticketing/tickets/ticket-attachments/). If the  ticket is manually recovered, you can include the attachment tokens on the new ticket.\n\n#### Allowed For\n\n* Admins and [agents in custom roles with permission](https://support.zendesk.com/hc/en-us/articles/4408882153882#topic_cxn_hig_bd) to manage suspended tickets on Enterprise plans\n* Unrestricted agents on all other plans\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "suspended_tickets",
                "attachments"
              ],
              "host": [
                "{{baseUrl}}"
              ],
