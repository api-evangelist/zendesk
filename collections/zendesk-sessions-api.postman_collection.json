          "name": "Zendesk Get  Api V2 Sessions",
          "request": {
            "name": "Zendesk Get  Api V2 Sessions",
            "description": {
              "content": "If authenticated as an admin, returns all the account's sessions. If authenticated as an agent or end user, returns only the sessions of the user making the request.\n\n#### Pagination\n\n- Cursor pagination (recommended)\n- Offset pagination\n\nSee [Pagination](/api-reference/introduction/pagination/).\n\n#### Allowed For\n\n* Admins, Agents, End users\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
