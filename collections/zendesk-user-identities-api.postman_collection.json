        {
          "id": "baa0ebd7-9b6c-4fea-aa4f-aa3b5758c323",
          "name": "Zendesk Put  Api V2 Users User_id Identities User_identity_id",
          "request": {
            "name": "Zendesk Put  Api V2 Users User_id Identities User_identity_id",
            "description": {
              "content": "This endpoint allows you to:\n\n* Set the specified identity as verified (by setting `verified` to \"true\" or `verification_method` to \"low\")\n* Unverify a verified identity (by setting `verified` to \"false\" or `verification_method` to \"none\")\n* Update the `value` property of the specified identity\n\nYou can't change an identity's `primary` attribute with this endpoint. You must use the [Make Identity Primary](#make-identity-primary) endpoint instead.\n\n#### Allowed For\n\n* Agents\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "users",
                ":user_id",
                "identities",
                ":user_identity_id"
